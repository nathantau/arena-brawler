[ext_resource type="Texture2D" path="res://assets/sprites/warden.png" id="2_sheet"]
[ext_resource type="Resource" path="res://data/weapons/warden_hammer.tres" id="3_sig"]
[ext_resource type="Texture2D" path="res://assets/sprites/warden_hand.png" id="4_hand"]
[ext_resource type="Resource" path="res://data/skills/barrier.tres" id="5_skill"]

[resource]
script = ExtResource("1_cd")
