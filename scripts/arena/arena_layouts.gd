static func count() -> int:
	return NAMES.size()


## The layout for arena `index`; `wide` picks the bigger Teams version (same name / theme).
static func get_layout(index: int, wide: bool = false) -> Array[String]:
	match index:
		1:
			return FOUNDRY_WIDE if wide else FOUNDRY
		2:
			return GYM_WIDE if wide else GYM
	return PIT_WIDE if wide else PIT


## Teams plays the wide layouts, everything else the standard ones.
static func is_wide(mode: MatchRules.Mode) -> bool:
	return mode == MatchRules.Mode.TEAMS


## Art name for the full-arena decal / overlay: the theme, or "<theme>_wide" (the tile sheet is always the theme's).
static func decor_name(index: int, wide: bool) -> StringName:
	return StringName(String(THEMES[index]) + "_wide") if wide else THEMES[index]
